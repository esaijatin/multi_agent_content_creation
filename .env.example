# =============================================================================
# AstraOS — Environment Configuration
# Copy to .env and adjust for local development. Never commit .env.
# =============================================================================

# --- Application ---
APP_NAME=AstraOS
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- API Gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT / Auth ---
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=astraos
POSTGRES_PASSWORD=astraos_dev_password
POSTGRES_DB=astraos
DATABASE_URL=postgresql+asyncpg://astraos:astraos_dev_password@postgres:5432/astraos

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Orchestrator ---
ORCHESTRATOR_URL=http://orchestrator:8001
ORCHESTRATOR_INTERNAL_API_KEY=orchestrator-internal-dev-key

# --- Chroma (Phase 3+) ---
CHROMA_HOST=chroma
CHROMA_PORT=8000

# --- MinIO (Phase 3+) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=astraos_minio
MINIO_SECRET_KEY=astraos_minio_secret
MINIO_BUCKET=astraos-artifacts

# --- Ollama (Phase 2+) ---
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL_PLANNER=qwen2.5:7b
OLLAMA_MODEL_WRITER=llama3:8b
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_DEFAULT_TEMPERATURE=0.4
OLLAMA_DEFAULT_MAX_TOKENS=4096

# --- RabbitMQ (Phase 8+) ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=astraos
RABBITMQ_PASSWORD=astraos_rabbit_password

# --- Observability (Phase 6+) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
